{
  "name": "limit-state",
  "private": true,
  "version": "0.12.1",
  "description": "Limit State \u2014 a structural sandbox that tells the truth. True FEM core, playful surface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/limit-state.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery:generate": "vite-node scripts/generate-gallery.mts",
    "profile:perf": "vite-node scripts/profile-perf.mts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "next": "16.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "next": {
      "sharp": "0.35.4"
    },
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.0",
    "vite-node": "6.0.0",
    "vitest": "^4.1.10"
  }
}
